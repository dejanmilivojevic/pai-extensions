#!/usr/bin/env bash
# Run one headless pai rollout for Harness² (see pai-harness2-batch.el).
#
#   pai-harness2-run --cwd WORKSPACE --prompt-file PROMPT --model ID \
#                    --events traj.jsonl --timeout 3600
#
# Environment:
#   PAI_EMACS      Emacs binary (default: emacs)
#   PAI_ROOT       pai checkout (default: the one this extension lives in)
#   PAI_LOAD_PATH  extra colon-separated load-path entries
set -euo pipefail

here="$(cd "$(dirname "$(readlink -f "${BASH_SOURCE[0]}")")/.." && pwd)"
root="${PAI_ROOT:-$(cd "$here/../.." && pwd)}"
emacs="${PAI_EMACS:-emacs}"

if [[ ! -f "$root/lisp/pai.el" ]]; then
  echo "pai-harness2-run: no pai checkout at $root (set PAI_ROOT)" >&2
  exit 2
fi

load=(-L "$root/lisp" -L "$here")
[[ -d "$root/vendor/vui" ]] && load+=(-L "$root/vendor/vui")
[[ -d "$root/test" ]] && load+=(-L "$root/test")      # pai-faux, for --faux
if [[ -n "${PAI_LOAD_PATH:-}" ]]; then
  IFS=: read -r -a extra <<< "$PAI_LOAD_PATH"
  for d in "${extra[@]}"; do [[ -n "$d" ]] && load+=(-L "$d"); done
fi

exec "$emacs" -Q --batch "${load[@]}" \
  --eval '(setq load-prefer-newer t)' \
  -l pai-harness2-batch -f pai-harness2-batch-main "$@" </dev/null
